EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
EXPO_PUBLIC_SUPABASE_REDIRECT_URL=nosh://auth/callback
EXPO_PUBLIC_AI_MODEL=qwen/qwen3.6-35b-a3b
EXPO_PUBLIC_ART_MODEL=qwen/qwen-image-3-pro
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=development
# Use a monitored private inbox in release builds. Without it, Settings opens
# the public support page, which must never be used for receipts or account data.
EXPO_PUBLIC_SUPPORT_EMAIL=
# App Store launch only. Keep Android and web RevenueCat keys unset until
# store-specific products and nutriai.subscription_products mappings exist.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
# EXPO_PUBLIC_REVENUECAT_WEB_API_KEY=
EXPO_PUBLIC_DEV_BYPASS_AUTH=false
EXPO_PUBLIC_SHOW_DEMO_COOKBOOK=false
EXPO_PUBLIC_NOSH_CONTEXT_MODEL_V2=false
