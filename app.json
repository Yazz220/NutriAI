{
  "expo": {
    "name": "Nosh",
    "slug": "nosh",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "nosh",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F7F2"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nosh.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Nosh uses your camera to capture recipe images.",
        "NSPhotoLibraryUsageDescription": "Nosh needs access to your photo library to import images for recipes.",
        "NSMicrophoneUsageDescription": "Nosh may use the microphone for voice input features.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.nosh.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5F7F2"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "INTERNET",
        "VIBRATE"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Nosh uses your camera to capture recipe images.",
          "microphonePermission": "Nosh may use the microphone for voice input."
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Nosh needs access to your photos to import images for recipes."
        }
      ]
    ],
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    },
    "updates": {
      "url": ""
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
