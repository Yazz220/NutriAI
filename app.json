{
  "expo": {
    "name": "Nosh",
    "slug": "nosh",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "nosh",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F7F2"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yaz12.nosh",
      "buildNumber": "9",
      "infoPlist": {
        "NSCameraUsageDescription": "Nosh uses your camera to capture recipe images.",
        "NSPhotoLibraryUsageDescription": "Nosh needs access to your photo library to import images for recipes.",
        "NSMicrophoneUsageDescription": "Nosh may use the microphone for voice input features.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.yaz12.nosh",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5F7F2"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Nosh uses your camera to capture recipe images.",
          "microphonePermission": "Nosh may use the microphone for voice input."
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Nosh needs access to your photos to import images for recipes."
        }
      ],
      "expo-apple-authentication",
      "expo-localization",
      "expo-router",
      "expo-asset",
      "expo-splash-screen"
    ],
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "c305bb83-fece-4f57-a9bc-6517323b9649"
      }
    },
    "updates": {
      "url": ""
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "yaz12"
  }
}
