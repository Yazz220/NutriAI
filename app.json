{
  "expo": {
    "name": "Nosh",
    "slug": "nosh",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "nosh",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/brand/platform/icon.png",
    "backgroundColor": "#F7F2EA",
    "primaryColor": "#65436F",
    "splash": {
      "image": "./assets/brand/platform/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F2EA"
    },
    "ios": {
      "icon": {
        "light": "./assets/brand/platform/icon.png",
        "dark": "./assets/brand/platform/icon-dark.png",
        "tinted": "./assets/brand/platform/icon-tinted.png"
      },
      "supportsTablet": false,
      "bundleIdentifier": "com.yaz12.nosh",
      "buildNumber": "13",
      "infoPlist": {
        "NSCameraUsageDescription": "Nosh uses your camera to capture recipe images.",
        "NSPhotoLibraryUsageDescription": "Nosh needs access to your photo library to import images for recipes.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1",
              "1C8F.1"
            ]
          }
        ],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeName",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality",
              "NSPrivacyCollectedDataTypePurposeProductPersonalization"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeEmailAddress",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePhotosorVideos",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality",
              "NSPrivacyCollectedDataTypePurposeProductPersonalization"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeOtherUserContent",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality",
              "NSPrivacyCollectedDataTypePurposeProductPersonalization"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeUserID",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePurchaseHistory",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ],
        "NSPrivacyTracking": false
      },
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.yaz12.nosh",
      "versionCode": 1,
      "icon": "./assets/brand/platform/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/platform/adaptive-icon.png",
        "backgroundImage": "./assets/brand/platform/adaptive-background.png",
        "monochromeImage": "./assets/brand/platform/adaptive-monochrome.png",
        "backgroundColor": "#F7F2EA"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Nosh uses your camera to capture recipe images.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Nosh needs access to your photos to import images for recipes.",
          "microphonePermission": false
        }
      ],
      "expo-apple-authentication",
      "expo-localization",
      "expo-router",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F2EA",
          "image": "./assets/brand/platform/splash.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "dark": {
            "image": "./assets/brand/platform/splash-dark.png",
            "backgroundColor": "#65436F"
          }
        }
      ],
      [
        "expo-share-intent",
        {
          "iosShareExtensionName": "ShareToNosh",
          "iosShareExtensionBundleIdentifier": "com.yaz12.nosh.share",
          "iosAppGroupIdentifier": "group.com.yaz12.nosh.share",
          "iosActivationRules": {
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsImageWithMaxCount": 1
          },
          "androidIntentFilters": [
            "text/*",
            "image/*"
          ],
          "androidMultiIntentFilters": []
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "favicon": "./assets/brand/platform/favicon.png",
      "name": "Nosh",
      "shortName": "Nosh"
    },
    "extra": {
      "eas": {
        "projectId": "c305bb83-fece-4f57-a9bc-6517323b9649"
      }
    },
    "updates": {
      "url": ""
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "yaz12"
  }
}
