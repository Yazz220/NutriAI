# Copy this file to .env and fill in values.
# IMPORTANT: .env must NOT be committed to git — it is listed in .gitignore.

# === Supabase (client-safe, public keys only) ===
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
EXPO_PUBLIC_SUPABASE_REDIRECT_URL=nosh://auth/callback
EXPO_PUBLIC_SUPABASE_IMAGES_BUCKET=recipe-images

# === AI Configuration ===
# All AI calls route through the Supabase ai-chat Edge Function.
# The Edge Function holds the provider API key as a secret.
# No AI keys belong in this file.
EXPO_PUBLIC_AI_MODEL=openai/gpt-oss-20b:free
EXPO_PUBLIC_AI_VISION_MODEL=qwen/qwen2.5-vl-72b-instruct:free

# === Recipe Providers ===
EXPO_PUBLIC_RECIPE_SOURCE=mealdb
EXPO_PUBLIC_MEALDB_API_KEY=1

# === Feature Flags ===
EXPO_PUBLIC_ENABLE_AI_PICKS=true
EXPO_PUBLIC_ENABLE_NUTRITION_DASHBOARD=true
EXPO_PUBLIC_OFFLINE_ONLY=false
EXPO_PUBLIC_DEV_BYPASS_AUTH=false
EXPO_PUBLIC_DEV_RESET_ONBOARDING=false

# === Edge Function secrets (set in Supabase Dashboard → Functions → Secrets) ===
# AI_API_KEY        — OpenRouter or compatible provider key
# AI_API_BASE       — Provider base URL (default: https://openrouter.ai/api/v1)
# AI_MODEL          — Default model override
# FATSECRET_CLIENT_ID / FATSECRET_CLIENT_SECRET — FatSecret OAuth2 credentials
# HUGGINGFACE_API_KEY — For Food-101-93M classifier
# USDA_API_KEY      — USDA FoodData Central (free at fdc.nal.usda.gov)
# STABILITY_API_KEY / MODELSLAB_API_KEY — Ingredient icon generation
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_REGION / ICON_S3_BUCKET — S3 icon storage
